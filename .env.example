# EasyWGSync 环境变量
# 启动时 env.js 自动读取项目根的 .env 并校验, 校验失败服务拒绝启动。
# 无需 node --env-file, npm run start (production) / npm run dev 都自动读 .env。
#
# .env 里用 NUXT_ 前缀的 key (env.js 校验后, runtimeConfig 直接读 process.env)。
# 端口用 NITRO_PORT (不是 NUXT_PORT)。

# ============ 必填 ============
# ewctl 客户端拉取配置用的密钥
NUXT_SECRET=your-ewctl-secret-here

# WireGuard 接口名(wgdashboard 里的配置名)
NUXT_WIREGUARD_CONFIG_NAME=cnc

# wgdashboard 地址(URL 格式)
NUXT_WIREGUARD_DASHBOARD_URL=http://127.0.0.1:10086

# wgdashboard API Key
NUXT_WIREGUARD_DASHBOARD_API_KEY=your-wgdashboard-api-key

# 会话密钥(随机 32 字符串)
NUXT_SESSION_SECRET=generate-a-random-32-char-string

# ============ 可选 ============
# Casdoor OIDC (不填则走开发绕过模式, 无需登录)
NUXT_CASDOOR_ISSUER=https://your-casdoor-instance.com
NUXT_CASDOOR_CLIENT_ID=your-client-id
NUXT_CASDOOR_CLIENT_SECRET=your-client-secret
# 留空则从请求 host 自动检测 (scheme+host+/api/auth/callback)
NUXT_CASDOOR_REDIRECT_URI=

# ============ 端口 ============
# 监听端口 (1-65535, 默认 3000)
NITRO_PORT=3000
