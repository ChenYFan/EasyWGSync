# WireGuard / WGDashboard
NUXT_SECRET=your-ewctl-secret-here
NUXT_WIREGUARD_CONFIG_NAME=cnc
NUXT_WIREGUARD_DASHBOARD_URL=http://127.0.0.1:10086
NUXT_WIREGUARD_DASHBOARD_API_KEY=your-wgdashboard-api-key

# Casdoor OIDC
NUXT_CASDOOR_ISSUER=https://your-casdoor-instance.com
NUXT_CASDOOR_CLIENT_ID=your-client-id
NUXT_CASDOOR_CLIENT_SECRET=your-client-secret
# Optional: leave empty to auto-detect from request host (scheme+host+/api/auth/callback).
# Set explicitly only if behind a proxy that doesn't forward X-Forwarded-Proto/Host.
# Whichever value resolves, add it to your Casdoor app's Redirect URLs whitelist.
NUXT_CASDOOR_REDIRECT_URI=

# Session
NUXT_SESSION_SECRET=generate-a-random-32-char-string
